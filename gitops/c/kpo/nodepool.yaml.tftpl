apiVersion: karpenter.sh/v1
kind: NodePool
metadata:
  name: karpenter-general
spec:
  template:
    spec:
      expireAfter: Never
      terminationGracePeriod: 120m
      startupTaints:
        - key: oke.oraclecloud.com/cni-not-ready
          effect: NoSchedule
      nodeClassRef:
        group: oci.oraclecloud.com
        kind: OCINodeClass
        name: karpenter-general
      requirements:
        - key: karpenter.sh/capacity-type
          operator: In
          values:
            - ${capacityType}
        - key: oci.oraclecloud.com/instance-shape
          operator: In
          values:
            - ${instanceShape}
  disruption:
    budgets:
      - nodes: 5%
    consolidateAfter: 60m
    consolidationPolicy: WhenEmpty
  limits:
    cpu: ${limitCpu}
    memory: ${limitMemory}
