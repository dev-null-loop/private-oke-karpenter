#cloud-config
write_files:
  - path: /usr/local/bin/oke-custom-bootstrap.sh
    permissions: "0755"
    content: |
      #!/usr/bin/env bash
      set -o errexit
      set -o nounset
      set -o pipefail

      md_url="http://169.254.169.254/opc/v2/instance/metadata"
      auth_hdr="Authorization: Bearer Oracle"

      fetch_md() {
        local key="$1"
        curl -sfL -H "$${auth_hdr}" --connect-timeout 2 --max-time 5 "$${md_url}/$${key}" 2>/dev/null || true
      }

      apiserver_host="$(fetch_md apiserver_host)"
      kubelet_ca_cert="$(fetch_md cluster_ca_cert)"
      kubelet_extra_args="$(fetch_md kubelet-extra-args)"
      cluster_dns="$(fetch_md kubedns_svc_ip)"

      args=(
        --apiserver-host "$${apiserver_host}"
        --apiserver-port "6443"
        --ca "$${kubelet_ca_cert}"
      )

      if [[ -n "$${kubelet_extra_args}" ]]; then
        args+=(--kubelet-extra-args "$${kubelet_extra_args}")
      fi

      if [[ -n "$${cluster_dns}" ]]; then
        args+=(--cluster-dns "$${cluster_dns}")
      fi

      exec /usr/bin/oke bootstrap "$${args[@]}"
  - path: /usr/local/bin/oke-bootstrap-reconcile.sh
    permissions: "0755"
    content: |
      #!/usr/bin/env bash
      set -o errexit
      set -o nounset
      set -o pipefail

      cert_path="/var/lib/kubelet/pki/kubelet-client-current.pem"
      attempts=0
      max_attempts=3

      sleep 45

      while (( attempts < max_attempts )); do
        if [[ -e "$${cert_path}" ]]; then
          exit 0
        fi

        if journalctl -u kubelet --since '2 minutes ago' --no-pager 2>/dev/null | grep -q 'Unauthorized'; then
          attempts=$((attempts + 1))
          /usr/local/bin/oke-custom-bootstrap.sh || true
        fi

        if [[ -e "$${cert_path}" ]]; then
          exit 0
        fi

        sleep 20
      done
  - path: /etc/systemd/system/oke-bootstrap-reconcile.service
    permissions: "0644"
    content: |
      [Unit]
      Description=OKE bootstrap reconcile for kubelet auth drift
      After=oke.service kubelet.service network-online.target
      Wants=network-online.target

      [Service]
      Type=oneshot
      ExecStart=/usr/local/bin/oke-bootstrap-reconcile.sh

      [Install]
      WantedBy=multi-user.target
runcmd:
  - systemctl daemon-reload
  - systemctl enable oke-bootstrap-reconcile.service
  - /usr/local/bin/oke-custom-bootstrap.sh
