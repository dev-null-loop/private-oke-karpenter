apiVersion: oci.oraclecloud.com/v1beta1
kind: OCINodeClass
metadata:
  name: karpenter-general
spec:
%{ if bootstrapMode == "prebootstrap" ~}
  preBootstrapInitScript: ${preBootstrapInitScript}
%{ endif ~}
%{ if bootstrapMode == "metadata" ~}
  metadata:
    user_data: ${metadataUserData}
%{ endif ~}
  shapeConfigs:
    - ocpus: ${shapeOcpus}
      memoryInGbs: ${shapeMemoryInGbs}
  volumeConfig:
    bootVolumeConfig:
      imageConfig:
        imageType: ${imageType}
%{ if imageSource == "filter" ~}
        imageFilter:
          compartmentId: ${imageFilterCompartmentId}
          osFilter: ${imageFilterOs}
          osVersionFilter: "${imageFilterOsVersion}"
%{ else ~}
        imageId: ${imageId}
%{ endif ~}
  networkConfig:
    primaryVnicConfig:
      subnetConfig:
        subnetId: ${primaryVnicSubnetId}
      assignPublicIp: ${primaryVnicAssignPublicIp}
    secondaryVnicConfigs:
      - subnetConfig:
          subnetId: ${secondaryVnicSubnetId}
        ipCount: ${podIpCount}
        skipSourceDestCheck: true
