	destination_type = "CIDR_BLOCK"
	protocol         = "6"
	stateless        = false
	tcp_options = {
	  max = 6443
	  min = 6443
	}
      },
      {
	description      = "Allow KPO pods to communicate with OKE services"
	destination      = "services"
	destination_type = "SERVICE_CIDR_BLOCK"
	protocol         = "6"
	stateless        = false
	tcp_options = {
	  max = 443
	  min = 443
	}
      },
      {
	description      = "Allow KPO pods to communicate with each other"
	destination      = "10.0.32.0/22"
	destination_type = "CIDR_BLOCK"
	protocol         = "all"
	stateless        = false
      },
      {
	description      = "Allow KPO pods to communicate with nodes"
	destination      = "10.0.10.0/24"
	destination_type = "CIDR_BLOCK"
