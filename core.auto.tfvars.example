source_ids = {
  "Oracle-Linux-9.6-2025.09.16-0" = "ocid1.image.oc1.."
}

instances = {
  bastion = {
    compartment         = "dev"
    availability_domain = 1
    create_vnic_details = {
      assign_public_ip = true
      subnet           = "svcs_lb"
    }
    display_name = "bastion"
    shape        = "VM.Standard.E5.Flex"
    shape_config = {
      memory_in_gbs = 16
      ocpus         = 2
    }
    source_details = {
      source_name = "Oracle-Linux-9.6-2025.09.16-0"
    }
    ssh_public_keys = [
      "ssh-rsa ..."
    ]
    managed_cluster = "c"
    cloud_init = [
      {
	content_type = "text/cloud-config"
	filename     = "userdata/helm.yaml.tftpl"
      },
      {
        content_type = "text/cloud-config"
	filename     = "userdata/argocd-bootstrap.yaml.tftpl"
      }
    ]
  }
}
