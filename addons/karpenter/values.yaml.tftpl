hostNetwork: true
dnsPolicy: ClusterFirstWithHostNet

settings:
  clusterCompartmentId: "${cluster_compartment_id}"
  vcnCompartmentId: "${vcn_compartment_id}"
  apiserverEndpoint: "${apiserver_endpoint}"
  ociVcnIpNative: ${oci_vcn_ip_native}
  ipFamilies:
%{ for family in ip_families ~}
    - ${family}
%{ endfor ~}
